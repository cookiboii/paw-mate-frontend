# Backend API URL
VITE_API_BASE_URL=http://localhost:8000
# GitHub Pages 등 서버리스 함수가 없는 정적 배포에서 사용할 업로드 API 주소
VITE_UPLOAD_API_URL=http://localhost:3000/api/upload

# Kakao OAuth (optional)
VITE_KAKAO_CLIENT_ID=your_kakao_javascript_key
VITE_KAKAO_REDIRECT_URI=http://localhost:8000/adoptmate/kakao

# Server-side only. Never prefix this variable with VITE_.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here
# 서버리스 업로드 API에 접근할 프런트 origin (예: https://your-id.github.io)
UPLOAD_ALLOWED_ORIGIN=http://localhost:5173
